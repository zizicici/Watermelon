          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дублікати в межах одного місяця зберігаються лише раз"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
