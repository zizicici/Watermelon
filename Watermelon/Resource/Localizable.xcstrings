    "backup.manifest.error.freshManifestRefused" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Monatsmanifest für %@ enthält möglicherweise noch wiederherstellbare Daten. Ein neues Manifest wird erst erstellt, wenn dies geklärt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The month manifest for %@ may still have recoverable data. A fresh manifest will not be created until that is resolved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el manifiesto mensual de %@ aún tenga datos recuperables. No se creará un manifiesto nuevo hasta que se resuelva."
