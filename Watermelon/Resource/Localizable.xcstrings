    "transfer.tutorial.sources.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle im Bereich „Fotos“ Bilder per Tippen oder Streichen aus. Füge im Bereich „Dateien“ über die Systemauswahl Dateien hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap or drag in Photos to select pictures. Use Select Files in Files to add files with the system picker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca o desliza en Fotos para seleccionar imágenes. Usa Seleccionar archivos en Archivos para añadirlos con el selector del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca o desliza en Fotos para seleccionar imágenes. Usa Seleccionar archivos en Archivos para agregarlos con el selector del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez ou faites glisser dans Photos pour sélectionner des images. Dans Fichiers, utilisez Sélectionner des fichiers pour les ajouter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「写真」でタップまたはスライドして画像を選択します。「ファイルを選択」からシステムの選択画面を使ってファイルを追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 영역에서 탭하거나 드래그해 이미지를 선택하세요. 파일 영역의 파일 선택을 눌러 시스템 선택기로 파일을 추가할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque ou deslize em Fotos para selecionar imagens. Em Arquivos, use Selecionar arquivos para adicioná-los pelo seletor do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque ou deslize em Fotografias para selecionar imagens. Em Ficheiros, use Selecionar ficheiros para os adicionar pelo seletor do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирайте изображения касанием или проведением в разделе «Фото». В разделе «Файлы» добавляйте файлы через системное окно выбора."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибирайте зображення дотиком або проведенням у розділі «Фото». У розділі «Файли» додавайте файли через системне вікно вибору."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“本地相册”区域点按或滑动选择图片；在“文件”区域通过系统文件选择器添加文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「本機相簿」區域點按或滑動選擇相片；在「檔案」區域透過系統檔案選擇器加入檔案。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「本機相簿」區域點按或滑動選擇相片；在「檔案」區域透過系統檔案選擇器加入檔案。"
          }
        }
      }
    },
