          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup está incompleto. A cópia no dispositivo é a única cópia completa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
