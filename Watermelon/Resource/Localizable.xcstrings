          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar o servidor SFTP. Verifique host, porta e rede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar o servidor SFTP. Verifique o host, porta e rede."
          }
        },
