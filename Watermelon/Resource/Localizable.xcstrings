    "home.localIndex.rebuildDetail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cache wird geleert und alle Einträge werden neu erstellt. Dies dauert länger, kann aber einen beschädigten Index wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear the cache and rebuild every entry. This is slower but can recover from corrupted data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la caché y reconstruye cada entrada. Lento, pero recupera datos corruptos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía la caché y reconstruye cada entrada. Lento, pero recupera datos corruptos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface le cache et reconstruit toutes les entrées. Cette opération est lente, mais permet de corriger les données corrompues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュを消去し、すべてのエントリを再作成します。時間はかかりますが、破損したキャッシュから復旧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시를 비우고 모든 항목을 다시 만듭니다. 느리지만 손상된 데이터를 복구합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa o cache e reconstrói todas as entradas. Lento, mas recupera dados corrompidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa a cache e reconstrói todas as entradas. Lento, mas recupera dados corrompidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистить кэш и перестроить все записи. Это медленнее, но позволяет восстановиться после повреждения данных."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистити кеш і перебудувати кожен запис. Це повільніше, але може відновити пошкоджені дані."
          }
        },
        "zh-Hans" : {
