    "auth.googleDrive.authorizationLimited.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google hat ein zeitlich begrenztes Aktualisierungstoken ausgestellt. Externe Projekte im Testmodus laufen normalerweise nach sieben Tagen ab. Veröffentlichen Sie die OAuth-App in der Produktion oder verwenden Sie ein internes Projekt und melden Sie sich dann erneut an, damit Hintergrundsicherungen zuverlässig funktionieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google issued a time-limited refresh token. External projects left in Testing normally expire after seven days. Publish the OAuth app to Production, or use an Internal project, then sign in again for reliable background backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google ha emitido un token de actualización con duración limitada. Los proyectos externos que permanecen en Pruebas suelen caducar a los siete días. Publica la app de OAuth en Producción, o usa un proyecto Interno, y vuelve a iniciar sesión para que las copias en segundo plano sean fiables."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google emitió un token de actualización con duración limitada. Los proyectos externos que permanecen en Pruebas suelen vencer después de siete días. Publica la app de OAuth en Producción, o usa un proyecto Interno, y vuelve a iniciar sesión para que los respaldos en segundo plano sean confiables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google a émis un jeton d’actualisation à durée limitée. Les projets externes laissés en mode Test expirent généralement au bout de sept jours. Publiez l’app OAuth en production, ou utilisez un projet Interne, puis reconnectez-vous pour assurer la fiabilité des sauvegardes en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google から有効期限付きの更新トークンが発行されました。テスト状態の外部プロジェクトは通常 7 日後に期限切れになります。OAuth アプリを本番環境に公開するか内部プロジェクトを使用し、もう一度サインインすると、バックグラウンドのバックアップを安定して実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google에서 유효 기간이 제한된 갱신 토큰을 발급했습니다. 테스트 상태로 둔 외부 프로젝트는 일반적으로 7일 후 만료됩니다. 안정적인 백그라운드 백업을 위해 OAuth 앱을 프로덕션으로 게시하거나 내부 프로젝트를 사용한 다음 다시 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google emitiu um token de atualização com duração limitada. Projetos externos mantidos em Teste normalmente expiram após sete dias. Publique o app OAuth em Produção, ou use um projeto Interno, e entre novamente para ter backups confiáveis em segundo plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google emitiu um token de atualização com duração limitada. Os projetos externos mantidos em Teste expiram normalmente após sete dias. Publique a aplicação OAuth em Produção, ou use um projeto Interno, e inicie sessão novamente para garantir cópias de segurança fiáveis em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google выдал токен обновления с ограниченным сроком действия. Внешние проекты, оставленные в режиме тестирования, обычно перестают работать через семь дней. Опубликуйте приложение OAuth в рабочей среде или используйте внутренний проект, затем войдите снова для надежного фонового резервного копирования."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google видав токен оновлення з обмеженим терміном дії. Зовнішні проєкти, залишені в режимі тестування, зазвичай припиняють діяти через сім днів. Опублікуйте програму OAuth у виробничому середовищі або використовуйте внутрішній проєкт, а потім увійдіть знову для надійного фонового резервного копіювання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 返回了有期限的刷新令牌。External 项目保持 Testing 状态时通常会在七天后失效。请将 OAuth App 发布为 Production，或使用 Internal 项目，然后重新登录，以保证后台备份持续可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 發出了有期限的重新整理權杖。外部專案維持測試狀態時，通常會在七天後失效。請將 OAuth App 發佈至正式版，或使用內部專案，然後重新登入，以確保背景備份可靠運作。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 發出了有期限的重新整理權杖。外部專案維持測試狀態時，通常會在七日後失效。請將 OAuth 應用程式發佈至正式版，或使用內部專案，然後重新登入，以確保背景備份可靠運作。"
          }
        }
      }
    },
