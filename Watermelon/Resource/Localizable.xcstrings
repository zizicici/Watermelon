    "auth.s3.validation.writeAccess" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den Anmeldedaten lässt sich der Schreibtest nicht abschließen. Prüfen Sie den Listen-, Lese-, Schreib-, Kopier- und Löschzugriff im Sicherungspfad. Grund: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credentials cannot complete the write probe. Confirm list, read, write, copy, and delete access on the backup path. Reason: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las credenciales no pueden completar la prueba de escritura. Verifica el acceso para listar, leer, escribir, copiar y eliminar en la ruta de copia. Motivo: %@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las credenciales no pueden completar la prueba de escritura. Verifica el acceso para listar, leer, escribir, copiar y eliminar en la ruta de respaldo. Motivo: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants ne peuvent pas terminer le test d’écriture. Vérifiez les accès de liste, lecture, écriture, copie et suppression sur le chemin de sauvegarde. Motif : %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証情報で書き込みプローブを完了できません。バックアップパスの一覧、読み取り、書き込み、コピー、削除のアクセス権を確認してください。原因: %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명으로 쓰기 프로브를 완료할 수 없습니다. 백업 경로의 목록, 읽기, 쓰기, 복사 및 삭제 권한을 확인하세요. 원인: %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As credenciais não conseguem concluir o teste de gravação. Verifique o acesso para listar, ler, gravar, copiar e excluir no caminho de backup. Motivo: %@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As credenciais não conseguem concluir o teste de escrita. Verifique o acesso para listar, ler, escrever, copiar e eliminar no caminho da cópia. Motivo: %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётные данные не прошли проверку записи. Проверьте доступ к просмотру списка, чтению, записи, копированию и удалению в пути резервного копирования. Причина: %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облікові дані не пройшли перевірку запису. Перевірте доступ до перегляду списку, читання, запису, копіювання й видалення на шляху резервного копіювання. Причина: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凭证无法完成写入探测。请确认对备份路径拥有列出、读取、写入、复制和删除权限。原因：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "憑證無法完成寫入探測。請確認對備份路徑擁有列出、讀取、寫入、複製和刪除權限。原因：%@"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
