    "transfer.settings.originalPhoto.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, senden bearbeitete Fotos das Original. Andernfalls wird die aktuelle bearbeitete Version gesendet, sofern Fotos eine bereitstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, edited photos send the original image. When disabled, the current edited version is sent when Photos provides one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se activa, las fotos editadas se envían como imágenes originales. Si se desactiva, se envía la versión editada actual cuando Fotos la proporciona."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se activa, las fotos editadas se envían como imágenes originales. Si se desactiva, se envía la versión editada actual cuando Fotos la proporciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les photos modifiées sont envoyées dans leur version d’origine. Sinon, la version modifiée actuelle est envoyée lorsque Photos la fournit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンの場合、編集済みの写真はオリジナル画像を送信します。オフの場合、「写真」が提供できるときは現在の編集済みバージョンを送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 편집된 사진의 원본 이미지를 보냅니다. 끄면 사진 앱에서 제공하는 경우 현재 편집본을 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, fotos editadas enviam a imagem original. Quando desativado, a versão editada atual é enviada quando o app Fotos a fornece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as fotografias editadas enviam a imagem original. Quando desativado, é enviada a versão editada atual quando a app Fotografias a disponibiliza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, для изменённых фото отправляются оригиналы. Если выключено, отправляется текущая изменённая версия, когда она доступна в приложении «Фото»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, для відредагованих фото надсилаються оригінали. Якщо вимкнено, надсилається поточна відредагована версія, коли вона доступна у «Фотографіях»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用时，编辑过的图片会发送原图；关闭时，如“照片”可提供，则发送当前编辑后的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用時，經編輯的相片會傳送原始相片；關閉時，若「照片」可提供，則傳送目前編輯後的版本。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，經編輯的相片會傳送原始相片；關閉後，如「相片」可提供，則傳送目前編輯後的版本。"
          }
        }
      }
    },
    "transfer.settings.originalVideo.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, senden bearbeitete Videos das Original. Andernfalls wird die aktuelle bearbeitete Version gesendet, sofern Fotos eine bereitstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, edited videos send the original video. When disabled, the current edited version is sent when Photos provides one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se activa, los vídeos editados se envían como vídeos originales. Si se desactiva, se envía la versión editada actual cuando Fotos la proporciona."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se activa, los vídeos editados se envían como vídeos originales. Si se desactiva, se envía la versión editada actual cuando Fotos la proporciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les vidéos modifiées sont envoyées dans leur version d’origine. Sinon, la version modifiée actuelle est envoyée lorsque Photos la fournit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンの場合、編集済みのビデオはオリジナルを送信します。オフの場合、「写真」が提供できるときは現在の編集済みバージョンを送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 편집된 비디오의 원본을 보냅니다. 끄면 사진 앱에서 제공하는 경우 현재 편집본을 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, vídeos editados enviam o vídeo original. Quando desativado, a versão editada atual é enviada quando o app Fotos a fornece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os vídeos editados enviam o vídeo original. Quando desativado, é enviada a versão editada atual quando a app Fotografias a disponibiliza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, для изменённых видео отправляются оригиналы. Если выключено, отправляется текущая изменённая версия, когда она доступна в приложении «Фото»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, для відредагованих відео надсилаються оригінали. Якщо вимкнено, надсилається поточна відредагована версія, коли вона доступна у «Фотографіях»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用时，编辑过的视频会发送原视频；关闭时，如“照片”可提供，则发送当前编辑后的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用時，經編輯的影片會傳送原始影片；關閉時，若「照片」可提供，則傳送目前編輯後的版本。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，經編輯的影片會傳送原始影片；關閉後，如「相片」可提供，則傳送目前編輯後的版本。"
          }
        }
      }
    },
    "transfer.settings.privacy.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt vor dem Senden standardmäßige GPS- und QuickTime-Standortmetadaten. Das Original in Fotos bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes standard GPS and QuickTime location metadata from exported files before sending. The original item in Photos is not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los metadatos de ubicación GPS y QuickTime estándar antes del envío. El original de Fotos no se modifica."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los metadatos de ubicación GPS y QuickTime estándar antes del envío. El original de Fotos no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les métadonnées de localisation GPS et QuickTime standard avant l’envoi. L’élément d’origine dans Photos reste inchangé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信前に、標準の GPS および QuickTime 位置情報メタデータを削除します。「写真」のオリジナルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내기 전에 표준 GPS 및 QuickTime 위치 메타데이터를 제거합니다. 사진 앱의 원본은 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove metadados padrão de localização GPS e QuickTime antes do envio. O item original no app Fotos não é alterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove metadados padrão de localização GPS e QuickTime antes do envio. O item original na app Fotografias não é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет стандартные метаданные геопозиции GPS и QuickTime перед отправкой. Оригинал в приложении «Фото» не изменяется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє стандартні метадані геопозиції GPS і QuickTime перед надсиланням. Оригінал у «Фотографіях» не змінюється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送前抹除导出文件中的标准 GPS 与 QuickTime 位置信息，不会修改“照片”中的原项目。"
          }
        },
        "zh-Hant" : {
