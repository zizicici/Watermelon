        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad está incompleta. La copia del dispositivo es la única copia completa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este respaldo está incompleto. La copia del dispositivo es la única copia completa."
