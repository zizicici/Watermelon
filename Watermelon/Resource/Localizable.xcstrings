            "state" : "translated",
            "value" : "Utilisez un nœud enregistré ou nouveau, ou connectez un ordinateur sur https://wmlink.app. Les fichiers sont enregistrés directement dans Inbox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みまたは新しいノードを使うか、https://wmlink.app でコンピュータを接続します。ファイルは直接 Inbox に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
