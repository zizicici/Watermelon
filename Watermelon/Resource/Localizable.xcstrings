    "home.localIndex.confirmRebuildMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vorhandene Cache wird gelöscht und alle Fotos werden erneut gescannt. Dies kann eine Weile dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The existing cache will be deleted and every photo will be rescanned. This can take a while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará la caché actual y todas las fotos se volverán a analizar. Puede tardar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará la caché actual y todas las fotos se volverán a analizar. Puede tardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache existant sera supprimé et toutes les photos seront réanalysées. Cela peut prendre du temps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のキャッシュを削除し、すべての写真を再スキャンします。時間がかかる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 캐시를 삭제하고 모든 사진을 다시 스캔합니다. 시간이 걸릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cache existente será apagado e todas as fotos serão verificadas novamente. Pode demorar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cache existente será apagada e todas as fotografias serão analisadas novamente. Pode demorar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Существующий кэш будет удалён, а все фото — отсканированы заново. Это может занять некоторое время."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточний кеш буде видалено й усі фото буде проскановано знову. Це може тривати певний час."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现有缓存将被清空，所有照片将被重新扫描，过程可能较慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現有快取將被清空，所有照片將被重新掃描，過程可能較慢。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
