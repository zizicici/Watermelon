            "value" : "Фонове автоматичне резервне копіювання доступне лише у версії Pro. Перейдіть на Pro, щоб увімкнути цю функцію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台自动备份是 Pro 专属功能。请升级到 Pro 以启用此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景自動備份是 Pro 專屬功能。請升級到 Pro 以啟用此功能。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
