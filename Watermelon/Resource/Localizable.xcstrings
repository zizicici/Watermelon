    "auth.sftp.privateKeyReuseFooter" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gespeicherte Schlüssel und die Passphrase werden als ******** angezeigt. Lassen Sie beide unverändert, um sie beizubehalten, oder geben Sie neue Werte ein. Leeren Sie die Passphrase, um sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved key and passphrase are shown as ********. Leave them unchanged to keep them; type to replace them. Clear the passphrase to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves y frases de acceso guardadas se muestran como ********. No las edites para conservarlas; escribe para reemplazarlas. Borra la frase de acceso para eliminarla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves y frases de acceso guardadas se muestran como ********. No las edites para conservarlas; escribe para reemplazarlas. Borra la frase de acceso para eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé et la phrase secrète enregistrées s’affichent sous la forme ********. Ne les modifiez pas pour les conserver ; saisissez de nouvelles valeurs pour les remplacer. Effacez la phrase secrète pour la supprimer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの鍵とパスフレーズは ******** と表示されます。変更しなければそのまま使用されます。入力すると置き換わります。パスフレーズを空にすると削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 키와 암호 문구는 ********로 표시됩니다. 그대로 두면 유지되고, 입력하면 교체됩니다. 암호 문구를 비우면 제거됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaves e frases de senha salvas aparecem como ********. Não edite para mantê-las; digite para substituí-las. Limpe a frase de senha para removê-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaves e frases de acesso guardadas aparecem como ********. Não edite para as manter; introduza texto para as substituir. Limpe a frase de acesso para a remover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые ключ и парольная фраза отображаются как ********. Не изменяйте их, чтобы сохранить; введите новые значения, чтобы заменить. Очистите парольную фразу, чтобы удалить её."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережені ключі та парольні фрази відображаються як ********. Не змінюйте їх, щоб зберегти; введіть нове значення, щоб замінити. Очистьте парольну фразу, щоб видалити її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的私钥和口令会显示为 ********。不修改会继续使用；输入内容会替换它。清空口令会移除口令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的私鑰和密語會顯示為 ********。不修改會繼續使用；輸入內容會取代它。清空密語會移除密語。"
