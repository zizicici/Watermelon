    "storage.detail.leftover.hash.action.detail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale erweiterte Prüfung am Listenende. Sie lädt Originaldateien herunter und vergleicht deren SHA-256-Hashes mit den Backend-Manifesten. Dies kann viel Zeit, Datenvolumen und temporären Speicher beanspruchen. Wenn Dateien ausgewählt sind, werden nur diese geprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional advanced check at the end of the list. It downloads originals and compares SHA-256 hashes with backend manifests, which may use significant time, data, and temporary storage. If files are selected, only those files are checked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobación avanzada opcional al final de la lista. Descarga los originales y compara sus hashes SHA-256 con los manifiestos del servidor, lo que puede requerir mucho tiempo, datos y almacenamiento temporal. Si hay archivos seleccionados, solo se comprueban esos archivos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificación avanzada opcional al final de la lista. Descarga los originales y compara sus hashes SHA-256 con los manifiestos del servidor, lo que puede requerir mucho tiempo, datos y almacenamiento temporal. Si hay archivos seleccionados, solo se verifican esos archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérification avancée facultative en fin de liste. Elle télécharge les originaux et compare leurs hachages SHA-256 aux manifestes du serveur, ce qui peut demander beaucoup de temps, de données et de stockage temporaire. Si des fichiers sont sélectionnés, seuls ceux-ci sont vérifiés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リスト末尾にある任意の高度な確認です。元のファイルをダウンロードし、SHA-256 ハッシュをバックエンドのマニフェストと比較するため、多くの時間、通信量、一時ストレージを使用する場合があります。ファイルが選択されている場合は、そのファイルだけを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록 끝에 있는 선택적 고급 확인입니다. 원본 파일을 다운로드하고 SHA-256 해시를 백엔드 매니페스트와 비교하므로 많은 시간, 데이터 및 임시 저장 공간을 사용할 수 있습니다. 파일을 선택한 경우 선택한 파일만 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificação avançada opcional no fim da lista. Ela baixa os originais e compara os hashes SHA-256 com os manifestos do servidor, o que pode usar muito tempo, dados e armazenamento temporário. Se houver arquivos selecionados, somente eles serão verificados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificação avançada opcional no fim da lista. Descarrega os originais e compara os hashes SHA-256 com os manifestos do servidor, o que pode utilizar muito tempo, dados e armazenamento temporário. Se houver ficheiros selecionados, apenas esses ficheiros serão verificados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательная расширенная проверка в конце списка. Она загружает исходные файлы и сравнивает хеши SHA-256 с манифестами сервера, что может потребовать много времени, трафика и временного хранилища. Если выбраны файлы, проверяются только они."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необов’язкова розширена перевірка наприкінці списку. Вона завантажує оригінальні файли та порівнює хеші SHA-256 із маніфестами сервера, що може потребувати багато часу, даних і тимчасового сховища. Якщо вибрано файли, перевірятимуться лише вони."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表末尾的可选高级检查。它会下载原文件并将 SHA-256 与后端清单比较，可能消耗较多时间、流量和临时存储；有勾选文件时只检查这些文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表末尾的選用進階檢查。它會下載原始檔案並將 SHA-256 與後端清單比較，可能耗用較多時間、流量和暫存空間；有勾選檔案時只檢查這些檔案。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表末尾的選用進階檢查。它會下載原始檔案並將 SHA-256 與後端清單比較，可能耗用較多時間、數據及暫存空間；有剔選檔案時只檢查這些檔案。"
          }
        }
      }
    },
