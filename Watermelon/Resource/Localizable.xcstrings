    "sftp.error.cannotConnect" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SFTP-Server ist nicht erreichbar. Prüfen Sie Host, Port und Netzwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot reach the SFTP server. Check the host, port, and network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con el servidor SFTP. Comprueba host, puerto y red."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar al servidor SFTP. Verifica host, puerto y red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur SFTP. Vérifiez l'hôte, le port et le réseau."
