    "auth.s3.pathStyle.hint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich für MinIO und selbst gehostete S3-kompatible Server. AWS S3, Cloudflare R2 und Backblaze B2 verwenden virtuell gehostete URLs; für OSS wird diese Einstellung automatisch deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required for MinIO and self-hosted S3-compatible servers. AWS S3, Cloudflare R2, and Backblaze B2 use virtual-hosted URLs; this setting is disabled automatically for OSS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para MinIO y servidores autohospedados compatibles con S3. AWS S3, Cloudflare R2 y Backblaze B2 usan URL con alojamiento virtual; esta opción se desactiva automáticamente para OSS."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para MinIO y servidores autohospedados compatibles con S3. AWS S3, Cloudflare R2 y Backblaze B2 usan URL con alojamiento virtual; esta opción se desactiva automáticamente para OSS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requis pour MinIO et les serveurs compatibles S3 auto-hébergés. AWS S3, Cloudflare R2 et Backblaze B2 utilisent des URL de type hébergement virtuel ; ce réglage est automatiquement désactivé pour OSS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MinIO やセルフホスト型の S3 互換サーバーで必要です。AWS S3、Cloudflare R2、Backblaze B2 は仮想ホスト形式を使用し、OSS ではこの設定が自動的に無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MinIO 및 자체 호스팅 S3 호환 서버에 필요합니다. AWS S3, Cloudflare R2, Backblaze B2는 가상 호스팅 방식 URL을 사용하며 OSS에서는 이 설정이 자동으로 비활성화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para MinIO e servidores S3-compatíveis auto-hospedados. AWS S3, Cloudflare R2 e Backblaze B2 usam URLs virtual-hosted; esta opção é desativada automaticamente para OSS."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para MinIO e servidores S3-compatíveis auto-alojados. AWS S3, Cloudflare R2 e Backblaze B2 usam URLs virtual-hosted; esta opção é desativada automaticamente para OSS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется для MinIO и самостоятельно развёрнутых S3-совместимых серверов. AWS S3, Cloudflare R2 и Backblaze B2 используют виртуальный хостинг; для OSS эта настройка отключается автоматически."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно для MinIO та власних S3-сумісних серверів. AWS S3, Cloudflare R2 й Backblaze B2 використовують URL-адреси у форматі virtual-hosted; для OSS це налаштування вимикається автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MinIO 与自托管 S3 兼容服务器需要开启。AWS S3、Cloudflare R2 和 Backblaze B2 使用 virtual-hosted URL；OSS 会自动关闭此开关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MinIO 與自架 S3 相容伺服器需要啟用。AWS S3、Cloudflare R2 和 Backblaze B2 使用 virtual-hosted URL；OSS 會自動關閉此開關。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MinIO 與自架 S3 相容伺服器需要啟用。AWS S3、Cloudflare R2 和 Backblaze B2 使用 virtual-hosted URL；OSS 會自動關閉此開關。"
          }
        }
      }
    },
