    "transfer.settings.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardeinstellungen für den Drop Mode. Änderungen an den Filtern gelten nur für die aktuelle Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defaults used when Drop Mode opens. Filter changes in an open browser apply only to that session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes predeterminados de Drop Mode. Los cambios de filtro solo se aplican a la sesión actual."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
