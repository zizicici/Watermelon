    "webdav.error.accessDenied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV-Zugriff wurde verweigert (403). Prüfen Sie die Kontoberechtigungen und den Endpunktpfad und versuchen Sie es erneut. Endpunkt: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV access was denied (403). Check account permissions and endpoint path, then try again. Endpoint: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha denegado el acceso a WebDAV (403). Comprueba los permisos de la cuenta y la ruta del endpoint e inténtalo de nuevo. Endpoint: %@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso a WebDAV (403). Verifica los permisos de la cuenta y la ruta del endpoint e inténtalo de nuevo. Endpoint: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès WebDAV a été refusé (403). Vérifiez les autorisations du compte et le chemin du point d’accès, puis réessayez. Point d’accès : %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV へのアクセスが拒否されました（403）。アカウントの権限とエンドポイントのパスを確認してから、もう一度お試しください。エンドポイント：%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV 접근이 거부되었습니다(403). 계정 권한과 엔드포인트 경로를 확인한 뒤 다시 시도해 주세요. 엔드포인트: %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao WebDAV foi negado (403). Verifique as permissões da conta e o caminho do endpoint e tente novamente. Endpoint: %@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao WebDAV foi negado (403). Verifique as permissões da conta e o caminho do endpoint e tente novamente. Endpoint: %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV отказал в доступе (403). Проверьте права учётной записи и путь эндпоинта, затем повторите попытку. Эндпоинт: %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до WebDAV заборонено (403). Перевірте дозволи облікового запису та шлях кінцевої точки й спробуйте ще раз. Кінцева точка: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV 访问被拒绝 (403)。请检查账号权限和端点路径后重试。端点：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV 存取被拒絕 (403)。請檢查帳號權限和端點路徑後再試。端點：%@"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV 存取被拒絕 (403)。請檢查帳號權限和端點路徑後再試。端點：%@"
          }
        }
      }
    },
