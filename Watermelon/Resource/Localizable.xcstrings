    "home.localIndex.incrementalDetail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur neue oder geänderte Fotos werden erneut gescannt; zwischengespeicherte Einträge werden wiederverwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
