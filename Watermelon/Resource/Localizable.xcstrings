    "storage.detail.leftover.hash.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese optionale erweiterte Prüfung am Listenende lädt Originaldateien erst nach der Bestätigung herunter und kann aufwendig sein. Ergebnisse dienen nur als Hinweis; beim Löschen wird jede Datei unter einer neuen Schreibsperre erneut geprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This optional advanced check at the end of the list downloads originals only after confirmation and may be costly. Results are advisory; deletion re-verifies each file under a new write lease."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta comprobación avanzada opcional al final de la lista solo descarga los originales tras la confirmación y puede ser costosa. Los resultados son orientativos; al eliminar, cada archivo se vuelve a verificar con un nuevo bloqueo de escritura."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta verificación avanzada opcional al final de la lista solo descarga los originales tras la confirmación y puede ser costosa. Los resultados son orientativos; al eliminar, cada archivo se vuelve a verificar con un nuevo bloqueo de escritura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vérification avancée facultative en fin de liste ne télécharge les originaux qu’après confirmation et peut être coûteuse. Les résultats sont indicatifs ; lors de la suppression, chaque fichier est revérifié sous un nouveau verrou d’écriture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リスト末尾の任意の高度な確認です。確認後にのみ元のファイルをダウンロードするため、負荷が高い場合があります。結果は参考用です。削除時には、新しい書き込みロックのもとで各ファイルを再確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록 끝의 선택적 고급 확인은 확인 후에만 원본을 다운로드하며 비용이 클 수 있습니다. 결과는 참고용이며, 삭제할 때 새 쓰기 잠금에서 각 파일을 다시 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta verificação avançada opcional no fim da lista só baixa os originais após a confirmação e pode ter um custo alto. Os resultados são apenas orientativos; ao excluir, cada arquivo é verificado novamente sob um novo bloqueio de gravação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta verificação avançada opcional no fim da lista só descarrega os originais após confirmação e pode ter um custo elevado. Os resultados são apenas indicativos; ao eliminar, cada ficheiro é novamente verificado sob um novo bloqueio de escrita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта необязательная расширенная проверка в конце списка загружает исходные файлы только после подтверждения и может быть ресурсоёмкой. Результаты носят справочный характер; при удалении каждый файл повторно проверяется с новой блокировкой записи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця необов’язкова розширена перевірка наприкінці списку завантажує оригінальні файли лише після підтвердження й може бути ресурсомісткою. Результати мають довідковий характер; під час видалення кожен файл повторно перевіряється з новим блокуванням запису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表末尾的高级检查为可选操作，确认后才会下载原文件，成本可能较高。结果仅供判断；删除时仍会在新的写入锁下重新验证每个文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表末尾的進階檢查為選用操作，確認後才會下載原始檔案，成本可能較高。結果僅供判斷；刪除時仍會在新的寫入鎖下重新驗證每個檔案。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表末尾的進階檢查為選用操作，確認後才會下載原始檔案，成本可能較高。結果只供判斷；刪除時仍會在新的寫入鎖下重新驗證每個檔案。"
          }
        }
      }
    },
