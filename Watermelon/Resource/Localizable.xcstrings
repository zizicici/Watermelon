          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo escanea fotos nuevas o modificadas; se reutilizan las entradas en caché."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
