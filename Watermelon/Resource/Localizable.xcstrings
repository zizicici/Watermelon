    "backup.log.icloudAccessEnabled" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zugriff auf iCloud-Fotos erlauben“ ist aktiviert. Watermelon kann iCloud-Originale bei Bedarf laden. Lokale Ressourcen werden mit der konfigurierten Parallelität verarbeitet; nur in iCloud vorhandene Ressourcen folgen anschließend mit 1 Worker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow iCloud Photo Access is enabled. Watermelon Backup may download iCloud originals on demand. Local resources use the configured concurrency; iCloud-only resources are processed afterward with 1 worker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Permitir acceso a fotos de iCloud” está activado. Backup Sandía puede descargar originales de iCloud cuando sea necesario. Los recursos locales usan la concurrencia configurada; los recursos que solo están en iCloud se procesan después con 1 proceso."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Permitir acceso a fotos de iCloud” está activado. Backup Sandía puede descargar originales de iCloud cuando sea necesario. Los recursos locales usan la concurrencia configurada; los recursos que solo están en iCloud se procesan después con 1 proceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Autoriser l’accès aux photos iCloud » est activé. Watermelon peut télécharger les originaux iCloud à la demande. Les ressources locales utilisent le parallélisme configuré ; celles présentes uniquement sur iCloud sont ensuite traitées par un seul processus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「iCloud 写真へのアクセスを許可」が有効です。スイカバックアップは必要に応じて iCloud のオリジナルをダウンロードできます。ローカルリソースは設定された同時実行数で処理し、iCloud のみにあるリソースはその後 1 ワーカーで処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"iCloud 사진 접근 허용\"이 활성화되어 있습니다. 수박 백업은 필요할 때 iCloud 원본을 다운로드할 수 있습니다. 로컬 리소스는 설정된 동시 실행 수로 처리하고, iCloud에만 있는 리소스는 이후 1개 워커로 처리합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Permitir acesso às fotos do iCloud” está ativado. O Backup Melancia pode baixar originais do iCloud sob demanda. Os recursos locais usam a concorrência configurada; os recursos somente no iCloud são processados depois com 1 worker."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Permitir acesso às fotos do iCloud” está ativado. O Backup Melancia pode descarregar originais do iCloud sob demanda. Os recursos locais usam o paralelismo configurado; os recursos apenas no iCloud são processados depois com 1 worker."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включён «Доступ к фото в iCloud». Арбуз Backup может загружать оригиналы из iCloud по запросу. Локальные ресурсы обрабатываются с настроенной параллельностью, а ресурсы только в iCloud — затем одним обработчиком."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнено «Дозволити доступ до фото iCloud». Кавун Backup може завантажувати оригінали iCloud за потреби. Локальні ресурси обробляються з налаштованою паралельністю, а ресурси лише в iCloud — потім одним обробником."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已启用「允许访问 iCloud 原件」：西瓜备份可按需下载 iCloud 原件。本地资源使用设置的并发数处理，仅存于 iCloud 的资源随后由 1 个 worker 处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已啟用「允許存取 iCloud 原件」：西瓜備份可按需下載 iCloud 原件。本機資源使用設定的並行數處理，僅存於 iCloud 的資源隨後由 1 個 worker 處理。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已啟用「允許存取 iCloud 原件」：西瓜備份可按需下載 iCloud 原件。本機資源使用設定的並行數處理，僅存於 iCloud 的資源隨後由 1 個 worker 處理。"
          }
        }
      }
    },
