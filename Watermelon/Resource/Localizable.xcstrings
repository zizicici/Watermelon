    "transfer.tutorial.noDeduplication.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Drop-Modus ist keine Sicherung und prüft nicht, ob eine Datei bereits vorhanden ist. Wenn du dasselbe Element erneut sendest, wird in Inbox eine doppelte Datei erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop Mode is not a backup and does not check whether a file already exists. Sending the same item again creates a duplicate file in Inbox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Drop no es una copia de seguridad y no comprueba si un archivo ya existe. Si vuelves a enviar el mismo elemento, se creará un archivo duplicado en Inbox."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Drop no es una copia de seguridad y no comprueba si un archivo ya existe. Si vuelves a enviar el mismo elemento, se creará un archivo duplicado en Inbox."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Drop n’est pas une sauvegarde et ne vérifie pas si un fichier existe déjà. Renvoyer le même élément crée un fichier en double dans Inbox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドロップモードはバックアップではなく、ファイルがすでに存在するかを確認しません。同じ項目をもう一度送信すると、Inboxに重複ファイルが作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드롭 모드는 백업이 아니며 파일이 이미 있는지 확인하지 않습니다. 같은 항목을 다시 보내면 Inbox에 중복 파일이 생성됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Drop não é um backup e não verifica se um arquivo já existe. Enviar o mesmo item novamente cria um arquivo duplicado na Inbox."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Drop não é uma cópia de segurança e não verifica se um ficheiro já existe. Enviar novamente o mesmo elemento cria um ficheiro duplicado na Inbox."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим Drop — это не резервное копирование: он не проверяет, существует ли файл. Повторная отправка того же объекта создаст дубликат в Inbox."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим Drop — це не резервне копіювання: він не перевіряє, чи файл уже існує. Повторне надсилання того самого елемента створить дублікат в Inbox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投递模式不同于备份，不会检查文件是否已经存在。重复投递同一项目会在 Inbox 中生成重复文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投遞模式不同於備份，不會檢查檔案是否已經存在。重複投遞同一項目會在 Inbox 中產生重複檔案。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投遞模式不同於備份，不會檢查檔案是否已經存在。重複投遞同一項目會在 Inbox 中產生重複檔案。"
          }
        }
      }
    },
