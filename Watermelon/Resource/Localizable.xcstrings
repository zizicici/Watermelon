    "transfer.tutorial.export.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Live-Photo-Videos, Originale vor Bearbeitungen und das Entfernen von Standortdaten. iCloud-Originale werden unterstützt, ohne Sicherungseinträge anzulegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Live Photo videos, originals before edits, and location removal. iCloud originals are supported without creating backup records."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige vídeos de Live Photos, originales anteriores a las ediciones y la eliminación de la ubicación. Se admiten originales de iCloud sin crear registros de copia de seguridad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige videos de Live Photos, originales anteriores a las ediciones y la eliminación de la ubicación. Se admiten originales de iCloud sin crear registros de copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les vidéos Live Photo, les originaux avant modification et la suppression de la localisation. Les originaux iCloud sont pris en charge sans créer d’enregistrements de sauvegarde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photoのビデオ、編集前のオリジナル、位置情報の削除を選べます。バックアップ記録を作成せずにiCloudオリジナルも送信できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Photo 비디오, 편집 전 원본, 위치 정보 제거 여부를 선택할 수 있습니다. 백업 기록을 만들지 않고 iCloud 원본도 전송할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha vídeos de Live Photos, originais antes das edições e a remoção da localização. Originais do iCloud são compatíveis sem criar registros de backup."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha vídeos de Live Photos, originais antes das edições e a remoção da localização. Os originais do iCloud são suportados sem criar registos de cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите видео Live Photo, оригиналы до редактирования и удаление геопозиции. Оригиналы из iCloud поддерживаются без создания записей резервного копирования."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть відео Live Photo, оригінали до редагування та видалення геопозиції. Оригінали з iCloud підтримуються без створення записів резервного копіювання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选择 Live Photo 视频、编辑前原片和位置清理；iCloud 原片也能投递，且不会写入备份记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可選擇 Live Photo 影片、編輯前原片和位置清理；iCloud 原片也能投遞，且不會寫入備份記錄。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可選擇 Live Photo 影片、編輯前原片及位置清理；iCloud 原片亦可投遞，而且不會寫入備份記錄。"
          }
        }
      }
    },
