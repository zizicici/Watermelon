    "auth.s3.provider.hint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie Alibaba Cloud OSS für eine an den Bucket gebundene benutzerdefinierte CNAME-Domain. Offizielle OSS-Endpunkte werden automatisch erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select Alibaba Cloud OSS for a custom CNAME bound to the Bucket. Official OSS endpoints are detected automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona Alibaba Cloud OSS para un CNAME personalizado vinculado al bucket. Los endpoints oficiales de OSS se detectan automáticamente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona Alibaba Cloud OSS para un CNAME personalizado vinculado al bucket. Los endpoints oficiales de OSS se detectan automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez Alibaba Cloud OSS pour un CNAME personnalisé associé au bucket. Les endpoints OSS officiels sont détectés automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucket にバインドされたカスタム CNAME を使う場合は Alibaba Cloud OSS を選択してください。公式 OSS エンドポイントは自動検出されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucket에 연결된 사용자 지정 CNAME을 사용하려면 Alibaba Cloud OSS를 선택하세요. 공식 OSS 엔드포인트는 자동으로 감지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione Alibaba Cloud OSS para um CNAME personalizado vinculado ao bucket. Os endpoints oficiais do OSS são detectados automaticamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione Alibaba Cloud OSS para um CNAME personalizado associado ao bucket. Os endpoints oficiais do OSS são detetados automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите Alibaba Cloud OSS для пользовательского CNAME, привязанного к бакету. Официальные конечные точки OSS определяются автоматически."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть Alibaba Cloud OSS для власного CNAME, прив’язаного до бакета. Офіційні кінцеві точки OSS визначаються автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已绑定 Bucket 的自定义 CNAME 时请选择阿里云OSS。官方 OSS Endpoint 会自动识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已綁定 Bucket 的自訂 CNAME 時請選擇阿里雲OSS。官方 OSS Endpoint 會自動識別。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已綁定 Bucket 的自訂 CNAME 時請選擇阿里雲OSS。官方 OSS Endpoint 會自動識別。"
          }
        }
      }
