    "mediaBrowser.action.incompleteDeleteLocal.confirmMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sicherung ist unvollständig. Die Kopie auf dem Gerät ist die einzige vollständige Kopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup is incomplete. The device copy is the only complete copy."
