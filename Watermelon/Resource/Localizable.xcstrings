    "transfer.tutorial.destination.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende einen gespeicherten oder neuen Knoten oder verbinde unter https://wmlink.app einen Computer. Dateien werden direkt in Inbox gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a saved or new node, or connect a computer at https://wmlink.app. Files go directly to Inbox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un nodo guardado o nuevo, o conecta un ordenador en https://wmlink.app. Los archivos se guardan directamente en Inbox."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
